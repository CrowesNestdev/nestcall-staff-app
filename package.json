{
  "name": "nestcall-staff",
  "version": "1.1.2",
  "description": "Nest Call - staff call alerts",
  "main": "src/main.js",
  "author": {
    "name": "Crowe's Nest"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uk.co.nest-call.staff",
    "productName": "Nest Call",
    "artifactName": "NestCall-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "Crowe's Nest"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Nest Call",
      "deleteAppDataOnUninstall": false
    },
    "copyright": "Copyright © Crowe's Nest"
  }
}
